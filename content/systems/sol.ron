                (id: "textiles", price: 18),
            ],
        ),
    ],
    stations: [
        (
            id: "lin-relay",
            name: "Lin Relay",
            description: "Earth's overflow customs desk circles the planet every three minutes. The station master insists this is a service, not a holding pattern.",
