            master: Some((
                name: "Relay Master Imani",
                portrait: Some("textures/chiefs/lin-relay.png"),
                greeting: "Lin Relay, berth six. The planet has a queue. We have a shorter queue and a better view of it.",
                offer_text: "A customs seizure cleared appeal this morning. The owner moved on. The inventory did not.",
                tribute_text: "Orbital handling charge. We handle your orbit by not reporting your approach vector.",
                quest_text: "Wayfarer's manifests arrived without the calibration seals. Take the seals before someone calibrates a stamp.",
