    planets: [
        (
            id: "tarsis-port",
            name: "Freeport Tarsis",
            description: "The only rule is the docking fee. Everything else is negotiation.",
            chief: Some((
                name: "Harbormaster Sixto",
                portrait: Some("textures/chiefs/tarsis-port.png"),
                greeting: "Welcome to Freeport, traveler. The docking fee is the law; everything else is conversation. Would you prefer the pleasant conversation, or the efficient one?",
                offer_text: "A consortium partner over-ordered and would rather sell quietly than explain loudly. The tariff is fair and the questions are few. Both suit me. Both should suit you.",
                tribute_text: "The harbormaster's discretionary assessment. It is discretionary in amount, not in payment. I accept credits, cargo, or the absence of incident.",
                quest_text: "The harbor board lists contracts no respectable port would touch. Fortunately, respectability was never our product. Choose something suited to your hull size.",
            )),
            commodities: [
                (id: "weapons", price: 35, icon: Some("textures/commodities/weapons.png")),
