ScenarioDef(
    id: "quest-delivery-loop",
    name: "Newhaven Relief Delivery Contract",
    description: "Dock on Earth, accept Director Vance's Newhaven Relief contract, warp to Newhaven, and turn in to Chief Okafor.",
    encounter_seed: Some(0),
    max_ticks: 2500,
    steps: [
        AssertAlive(true),
        FlyToPlanet(system: "sol", planet: "earth", land: true),
        AssertDocked(Some("earth")),
        AssertEncounter(mood: Some("quest")),
        Respond(choice: "accept_quest"),
        AssertActiveQuests(count: 1),
        AssertCargo(commodity: "medicine", min_qty: 4),
        LiftOff,
        FlyToPlanet(system: "alpha-centauri", planet: "newhaven", land: true),
        AssertDocked(Some("newhaven")),
        AssertEncounter(mood: Some("turn_in")),
        Respond(choice: "turn_in"),
        AssertActiveQuests(count: 0),
        AssertCompletedQuest("newhaven-relief"),
        AssertCredits(min: Some(895), max: None),
    ],
)
