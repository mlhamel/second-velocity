(
    id: "faction-control",
    name: "The Scoreboard Moves",
    description: "Run a rebellion contract out of Vega Station, watch reputation and system control shift toward the Rebellion, then read the weekly dispatch.",
    encounter_seed: Some(10),
    max_ticks: 4000,
    steps: [
        AssertAlive(true),
        AdvanceContractRefreshes(refreshes: 2),
        AssertReputation(faction: "rebellion", min: Some(0), max: Some(0)),
        AssertControl(system: "vega", controller: Some("rebellion"), min_meter: Some(-60), max_meter: Some(-60)),
        FlyToPlanet(system: "vega", planet: "vega-station", land: true),
        AssertDocked(Some("vega-station")),
        AssertEncounter(mood: Some("quest")),
        Respond(choice: "accept_quest"),
        AssertActiveQuests(count: 1),
        LiftOff,
        FlyToPlanet(system: "sol", planet: "earth", land: true),
        AssertDocked(Some("earth")),
        AssertEncounter(mood: Some("turn_in")),
        Respond(choice: "turn_in"),
        AssertReputation(faction: "rebellion", min: Some(5), max: Some(5)),
        AssertControl(system: "vega", controller: Some("rebellion"), min_meter: Some(-70), max_meter: Some(-70)),
        AdvanceDispatch,
        AssertDispatch(contains: Some("Rebellion holds 1")),
        AssertAlive(true),
    ],
)