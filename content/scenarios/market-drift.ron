(
    id: "market-drift",
    name: "Flood Earth",
    description: "Buy out Earth's food, watch the economy tick spike the price, dump the hold, and watch it sink and heal.",
    starting_credits: Some(42000),
    max_ticks: 4000,
    steps: [
        FlyToPlanet(system: "sol", planet: "earth", land: true),
        BuyShip(ship: "terran-hauler"),
        Trade(action: "buy", commodity: "food", qty: 45),
        AssertPrice(system: "sol", location: "earth", commodity: "food", min: Some(7), max: Some(9)),
        AdvanceEconomyTicks(ticks: 1),
        AssertPrice(system: "sol", location: "earth", commodity: "food", min: Some(10), max: Some(14)),
        Trade(action: "sell", commodity: "food", qty: 45),
        AdvanceEconomyTicks(ticks: 1),
        AssertPrice(system: "sol", location: "earth", commodity: "food", min: Some(7), max: Some(8)),
        AdvanceEconomyTicks(ticks: 10),
        AssertPrice(system: "sol", location: "earth", commodity: "food", min: Some(7), max: Some(9)),
        LiftOff,
        SetFlight(throttle: 1.0, turn: 0.0, fire: false),
        Advance(ticks: 30),
        AssertAlive(true),
    ],
)