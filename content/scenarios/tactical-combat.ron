(
    id: "tactical-combat",
    name: "Capacitor, Afterburner, Turret, and Seeker Lock",
    description: "Install a surge capacitor, rotary turret, and seeker rack on Earth, test afterburner capacitor drain, retrograde braking, target lock, and guided fire against the Alpha Centauri pirate.",
    starting_credits: Some(15000),
    max_ticks: 2500,
    steps: [
        FlyToPlanet(system: "sol", planet: "earth", land: true),
        SellOutfit(outfit: "light-blaster"),
        BuyOutfit(outfit: "quad-turret"),
        BuyOutfit(outfit: "seeker-rack"),
        BuyOutfit(outfit: "capacitor-bank"),
        AssertLoadout(outfits: ["quad-turret", "seeker-rack", "capacitor-bank"]),
        LiftOff,
        SetFlight(throttle: 1.0, turn: 0.0, fire: false),
        SetAfterburner(true),
        Advance(ticks: 30),
        AssertEnergy(min: Some(10.0), max: Some(98.0)),
        SetAfterburner(false),
        SetFlight(throttle: 0.0, turn: 0.0, fire: false),
        SetBrake(true),
        Advance(ticks: 25),
        SetBrake(false),
        CycleTarget(hostile_only: false),
        AssertTargetLocked(true),
        FlyToSystem(system: "alpha-centauri"),
        CycleTarget(hostile_only: true),
        AssertTargetLocked(true),
        SetFlight(throttle: 0.4, turn: 0.0, fire: true),
        SetSecondaryFiring(true),
        Advance(ticks: 35),
        SetSecondaryFiring(false),
        SetFlight(throttle: 0.0, turn: 0.0, fire: false),
        FlyToPlanet(system: "alpha-centauri", planet: "newhaven", land: true),
        AssertDocked(Some("newhaven")),
        AssertAlive(true),
    ],
)
