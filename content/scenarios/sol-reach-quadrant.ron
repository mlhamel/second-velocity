(
    id: "sol-reach-quadrant",
    name: "Sol Reach Quadrant Trade & Contract Circuit",
    description: "Verify quadrant-scoped world and contract board in sol-reach: refresh the quadrant contract board, haul food from Greenreach in Lalande to Earth in Sol, and complete the round-trip profit.",
    max_ticks: 3200,
    steps: [
        AssertAlive(true),
        AssertSystem("sol"),
        AdvanceContractRefreshes(refreshes: 1),
        FlyToPlanet(system: "lalande", planet: "greenreach", land: true),
        AssertSystem("lalande"),
        AssertDocked(Some("greenreach")),
        Trade(action: "buy", commodity: "textiles", qty: 15),
        AssertCargo(commodity: "textiles", min_qty: 15),
        LiftOff,
        AssertDocked(None),
        FlyToPlanet(system: "sol", planet: "earth", land: true),
        AssertSystem("sol"),
        AssertDocked(Some("earth")),
        Trade(action: "sell", commodity: "textiles", qty: 15),
        AssertCredits(min: Some(540), max: None),
        AssertAlive(true),
    ],
)
