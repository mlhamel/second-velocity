(
    id: "contract-refresh",
    name: "Contract Board Round Trip",
    description: "Refresh the contract board, dock at Vega Station, take a generated parcel run to Earth, refresh mid-job, and turn it in for pay.",
    encounter_seed: Some(10),
    max_ticks: 4000,
    steps: [
        AssertAlive(true),
        AdvanceContractRefreshes(refreshes: 2),
        FlyToPlanet(system: "vega", planet: "vega-station", land: true),
        AssertDocked(Some("vega-station")),
        AssertEncounter(mood: Some("quest")),
        Respond(choice: "accept_quest"),
        AssertActiveQuests(count: 1),
        AssertCargo(commodity: "food", min_qty: 5),
        AdvanceContractRefreshes(refreshes: 1),
        AssertActiveQuests(count: 1),
        LiftOff,
        FlyToPlanet(system: "sol", planet: "earth", land: true),
        AssertDocked(Some("earth")),
        AssertEncounter(mood: Some("turn_in")),
        Respond(choice: "turn_in"),
        AssertActiveQuests(count: 0),
        AssertCredits(min: Some(700), max: None),
        AssertAlive(true),
    ],
)