(
    id: "shipyard-upgrade",
    name: "Earn a Courier",
    description: "Start just below the net courier price, earn the difference through a real trade loop, buy at Earth, and fly the owned upgrade.",
    starting_credits: Some(11990),
    max_ticks: 3500,
    steps: [
        FlyToPlanet(system: "sol", planet: "earth", land: true),
        Trade(action: "buy", commodity: "food", qty: 20),
        LiftOff,
        FlyToPlanet(system: "alpha-centauri", planet: "newhaven", land: true),
        Trade(action: "sell", commodity: "food", qty: 20),
        LiftOff,
        FlyToPlanet(system: "sol", planet: "earth", land: true),
        BuyShip(ship: "terran-courier"),
        AssertShip("terran-courier"),
        AssertShipStats(max_shields: 45.0, max_armor: 30.0, max_fuel: 140.0, cargo: 26, weapon_slots: 1),
        AssertLoadout(outfits: ["light-blaster"]),
        LiftOff,
        SetFlight(throttle: 1.0, turn: 0.0, fire: false),
        Advance(ticks: 30),
        AssertAlive(true),
    ],
)
